# ==============================================================================
# Smart Subscription Advisor - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT commit real secrets or credentials to version control.

# Flask Core Configuration
SECRET_KEY=your-secure-random-secret-key-at-least-32-chars
FLASK_DEBUG=False
PORT=5000

# JWT Authentication Configuration
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_COOKIE_SECURE=False

# Database Configuration (Option A: Full Connection URI - e.g. for PaaS / Cloud)
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/smart_subscription_advisor

# Database Configuration (Option B: Individual Connection Parameters)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_subscription_advisor
DB_USER=root
DB_PASSWORD=your_db_password

# Email / SMTP Configuration
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=noreply@smartsubscriptionadvisor.com
